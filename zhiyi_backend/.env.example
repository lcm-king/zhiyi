# =============================================================================
# 智医 (ZhiYi) — 环境变量配置
# 基层医疗AI辅助诊疗平台
# =============================================================================
# 使用方法：cp .env.example .env 并修改实际值

# ── 运行模式 ───────────────────────────────────────────────
DEBUG=true                   # 开发模式：true 开启详细日志和自动重载
LOG_LEVEL=INFO               # 日志级别：DEBUG | INFO | WARNING | ERROR
DEMO_LOGIN_ENABLED=false     # 演示登录开关：本地联调可开，生产必须保持 false

# ── MySQL 主数据库 ─────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=zhiyi
# MySQL 连接池配置
DB_POOL_SIZE=10              # 连接池核心连接数
DB_MAX_OVERFLOW=20           # 超出 pool_size 的最大连接数

# ── JWT 认证 ───────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080    # Token 有效期（分钟），默认 7 天

# ── Redis 缓存 ─────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=604800              # 会话过期时间（秒），默认 7 天

# ── CORS 跨域 ──────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

# ── 高德地图 API ───────────────────────────────────────────
AMAP_JS_API_KEY=your_js_api_key_here
AMAP_SERVER_API_KEY=your_server_api_key_here
AMAP_BASE_URL=https://restapi.amap.com/v3

# ── 通义千问 AI（DashScope）────────────────────────────────
# 用于 AI 辅助诊断、检查报告解读、医学知识库问答（RAG 向量检索 + LLM 推理）
# 申请地址：https://dashscope.aliyun.com/（阿里云百炼平台）
# 兼容 OpenAI SDK 格式，通过 compatible-mode 端点访问
QWEN_API_KEY=your_qwen_api_key_here
QWEN_CHAT_MODEL=qwen3.7-max
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 字段级加密（Fernet）──────────────────────────────────
# 敏感字段（身份证号等）加密存储密钥；未配置时自动从 JWT_SECRET_KEY 派生
FIELD_ENCRYPT_KEY=

# ── OpenCode Go（可选备用；当前对话大模型为 Qwen3.7-max）──
# 官网：https://opencode.ai/go ；API：https://opencode.ai/zen/go/v1
OPENCODEGO_API_KEY=sk-your-opencodego-key-here
OPENCODEGO_API_URL=https://opencode.ai/zen/go/v1
OPENCODEGO_CHAT_MODEL=deepseek-v4-flash
